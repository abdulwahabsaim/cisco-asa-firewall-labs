! Cisco IOS Software, Linux - L2 Enterprise Software (I86BI_LINUX-ADVENTERPRISEK9-15.2D)
! Device: DMZ-Switch (Layer 2 Distribution Switch for Isolated DMZ Web Servers)
! Lab 02: 802.1Q Trunking & VLAN Segregation
!
version 15.2
hostname DMZ-Switch
!
no ip domain-lookup
!
! --- Layer 2 VLAN Segmentation ---
vlan 10
 name Web1-VLAN
!
vlan 20
 name Web2-VLAN
!
vlan 30
 name Web3-VLAN
!
! --- Trunk Uplink to Cisco ASA Parent Port (Ethernet2) ---
interface Ethernet0/0
 description Trunk_Uplink_to_ASA_Ethernet2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30
 no shutdown
!
! --- Access Downlinks to Isolated Web Server Hosts ---
interface Ethernet0/1
 description Access_VLAN_10_to_Web1
 switchport mode access
 switchport access vlan 10
 no shutdown
!
interface Ethernet0/2
 description Access_VLAN_20_to_Web2
 switchport mode access
 switchport access vlan 20
 no shutdown
!
interface Ethernet0/3
 description Access_VLAN_30_to_Web3
 switchport mode access
 switchport access vlan 30
 no shutdown
!
end
